# ── SERVER ──
PORT=3000
NODE_ENV=production

# ── DATABASE (Railway PostgreSQL) ──
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── FIREBASE ADMIN (للـ Auth فقط) ──
FIREBASE_PROJECT_ID=wafa-platform
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@wafa-platform.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── JWT ──
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ── CORS ──
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5500

# ── BUNNY CDN (لحماية الفيديوهات) ──
BUNNY_LIBRARY_ID=your_library_id
BUNNY_API_KEY=your_api_key
BUNNY_STREAM_SECRET=your_stream_secret
